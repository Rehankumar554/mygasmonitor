<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SpinnerTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColor">#757575</item>
        <item name="android:textColorHint">#757575</item>
    </style>

    <style name="RoundedDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogCornerShape</item>
        <item name="android:background">@color/white</item>

        <!-- Fix readable text colors -->
        <item name="android:textColorPrimary">#212121</item> <!-- list text, main -->
        <item name="android:textColorSecondary">#424242</item> <!-- subtitle text -->
        <item name="android:textColor">#212121</item> <!-- fallback -->
        <item name="titleTextColor">#212121</item> <!-- dialog title color -->
        <item name="colorControlActivated">#4A6CF7</item> <!-- active radio/check tint -->
    </style>

    <style name="DialogSlideAnimation">
        <item name="android:windowEnterAnimation">@android:anim/slide_in_left</item>
        <item name="android:windowExitAnimation">@android:anim/slide_out_right</item>
    </style>

    <style name="AlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- Background -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="android:background">#FFFFFF</item>

        <!-- Title and Message Colors -->
        <item name="android:textColorPrimary">#212121</item> <!-- Title -->
        <item name="android:textColorSecondary">#424242</item> <!-- Message -->

        <!-- Corner Radius -->
        <item name="shapeAppearanceOverlay">@style/DialogCornerShape</item>

        <!-- Buttons -->
        <item name="buttonBarPositiveButtonStyle">@style/DialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogNegativeButton</item>
    </style>

    <style name="DialogCornerShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="DialogPositiveButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#3F51B5</item>
    </style>

    <style name="DialogNegativeButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#757575</item>
    </style>


</resources>