<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:fitsSystemWindows="true">

    <!-- Back Button (top-left) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        app:backgroundTint="#FFFFFF"
        app:tint="#212121"
        app:fabSize="mini"
        app:srcCompat="@drawable/ic_arrow_back_24"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Page Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personal Details"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#212121"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="28dp"
        android:gravity="center"/>

    <!-- Card Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        android:layout_margin="24dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Name"
                android:textStyle="bold"
                android:textColor="#424242"
                android:textSize="16sp"
                />

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rehan Kumar"
                android:textColor="#757575"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consumer ID"
                android:textStyle="bold"
                android:textColor="#424242"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvConsumerId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="123456789"
                android:textColor="#757575"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aadhaar ID"
                android:textStyle="bold"
                android:textColor="#424242"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvAadhaarId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XXXX-XXXX-1234"
                android:textColor="#757575"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textStyle="bold"
                android:textColor="#424242"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91 9876543210"
                android:textColor="#757575"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textStyle="bold"
                android:textColor="#424242"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="william.henry.moody@my-own-personal-domain.com"
                android:textColor="#757575"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Cylinder Type"
                android:textStyle="bold"
                android:textColor="#424242"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCylinderType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Domestic 14.2kg"
                android:textColor="#757575"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Agency Name"
                android:textStyle="bold"
                android:textColor="#424242"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvAgencyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HP Gas Agency"
                android:textColor="#757575"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agency Booking Number"
                android:textStyle="bold"
                android:textColor="#424242"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvAgencyBookingNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91 9812345678"
                android:textColor="#757575"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Last Refill Date"
                android:textStyle="bold"
                android:textColor="#424242"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvLastRefill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 Oct 2025"
                android:textColor="#757575"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Home Address"
                android:textStyle="bold"
                android:textColor="#424242"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sector 14, Green Park, Delhi"
                android:textColor="#757575"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBook"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Edit Details"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="#3F51B5"
        app:cornerRadius="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
